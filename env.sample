# This file contains environment variables expected by the application.
# It should be copied to .env and values should be set appropriately for your environment.
#
# REQUIRED: every <change-me-strong-random> placeholder MUST be overridden
# before any non-local deployment. Generate strong values, e.g.:
#   POSTGRES_PASSWORD=$(openssl rand -base64 32)
#   ADMIN_PASSWORD=$(openssl rand -base64 32)
#   JWT_SECRET=$(openssl rand -hex 64)

# Deployment mode, `prod` or `dev` (anything else fails startup).
#   prod: the public shop at https://miedaria-paunilor.ro.
#   dev:  a test copy at https://dev.miedaria-paunilor.ro. Every page asks for
#         DEV_ACCESS_USERNAME / DEV_ACCESS_PASSWORD (remembered for 30 days in a
#         cookie), search engines are told not to index it, email subjects start
#         with [DEV], and STRIPE_SECRET_KEY must be a test-mode key. Use its own
#         database, secrets, Sameday demo credentials and
#         ALLOWED_ORIGIN=VITE_SITE_URL=https://dev.miedaria-paunilor.ro.
MODE=prod
# Required when MODE=dev; the password needs at least 12 characters.
DEV_ACCESS_USERNAME=
DEV_ACCESS_PASSWORD=

# PostgreSQL database host
POSTGRES_HOST=database

# PostgreSQL database port
POSTGRES_PORT=5432

# PostgreSQL database user
POSTGRES_USER=user

# PostgreSQL database password
POSTGRES_PASSWORD=<change-me-strong-random>

# Default administrator username for initial setup
ADMIN_USERNAME=admin

# Default administrator password for initial setup
ADMIN_PASSWORD=<change-me-strong-random>

# Full database connection URL (ensure this matches the above settings)
DATABASE_URL=postgres://user:<change-me-strong-random>@database/miedaria_paunilor

# Secret key for JWT token generation and validation
JWT_SECRET=<change-me-strong-random>

# PostgreSQL database name
POSTGRES_DB=miedaria_paunilor

# Base URL for the frontend to connect to the backend API. MUST BE SET.
# For development with separate frontend/backend servers: http://localhost:8000/api
# For production with Nginx proxy: /api (relative URL)
VITE_API_BASE_URL=/api

# Public site origin used to emit absolute URLs in SEO meta (canonical, hreflang,
# og:image, og:url, JSON-LD). No trailing slash. Must match the canonical host
# (apex, not www). Falls back to window.location.origin when unset, but
# crawlers/link-preview bots see correct values only when this is set.
VITE_SITE_URL=https://miedaria-paunilor.ro

# Data controller named in the privacy policy (baked into the frontend at
# build time; the build fails if any is empty). Replace the placeholders with
# the real legal name, CUI and Trade Register number before going live.
VITE_BUSINESS_LEGAL_NAME="Miedăria Păunilor SRL"
VITE_BUSINESS_TAX_ID=RO00000000
VITE_BUSINESS_TRADE_REGISTER_NO=J00/0000/2026

# Port on which the Rust backend server will listen. MUST BE SET.
BACKEND_PORT=8000

# Address serving Prometheus metrics: the backend's fixed IP on the internal
# monitoring network (docker-compose.yml) and the port scraped in
# monitoring/prometheus/prometheus.yml. Binding to that interface alone keeps
# the metrics away from nginx and the frontend network. For `cargo run`
# outside Docker use 127.0.0.1:9100. MUST BE SET.
METRICS_ADDR=172.31.99.10:9100

# Directory where uploaded images will be stored. MUST BE SET.
IMAGE_UPLOAD_DIR=/app/images

# The label renderer (labels/). docker-compose.yml sets it to
# http://labels:8080 for the backend; set it here only for `cargo run`
# outside Docker, pointing at a locally run `python3 labels/server.py`.
# LABELS_URL=http://127.0.0.1:8080

# Number of hours until a generated JWT token expires. MUST BE SET.
JWT_EXPIRATION_HOURS=24

# Allowed CORS origin (frontend URL). Restrict to your domain in production. MUST BE SET.
# Development: https://localhost
# Production: https://yourdomain.com
ALLOWED_ORIGIN=https://localhost

# Stripe secret API key (Dashboard -> Developers -> API keys). Use the test-mode
# key (sk_test_...) everywhere except production. MUST BE SET.
STRIPE_SECRET_KEY=<get-from-stripe-dashboard>

# Stripe webhook signing secret (whsec_...). Production: Dashboard -> Developers
# -> Webhooks endpoint secret. Local dev: printed by
#   stripe listen --forward-to localhost:8000/api/webhooks/stripe
# MUST BE SET.
STRIPE_WEBHOOK_SECRET=<get-from-stripe-dashboard>

# Outgoing email (newsletter). Production uses the Brevo SMTP relay; verify
# the sender domain (SPF/DKIM/DMARC) in Brevo before the first send.
# SMTP_SECURITY: starttls (port 587), tls (implicit TLS, port 465) or none.
# `none` is only for the local Mailpit catcher, started with
#   docker compose --profile mail-dev up
# using SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_SECURITY=none and any
# username/password; captured mail is shown at http://127.0.0.1:8025.
# MUST BE SET.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=<get-from-brevo-dashboard>
SMTP_PASSWORD=<get-from-brevo-dashboard>
SMTP_FROM_ADDRESS=newsletter@miedaria-paunilor.ro
SMTP_FROM_NAME="Miedăria Păunilor"

# "Continue with Google" for customer accounts (optional: leave both empty to
# hide it). Google Cloud Console -> APIs & Services -> Credentials -> OAuth
# client ID, type "Web application", with the authorized redirect URI
#   <ALLOWED_ORIGIN>/api/account/google/callback
# (e.g. https://localhost/api/account/google/callback for development).
# Only the openid and email scopes are requested. Set both, or leave both
# empty to disable Google sign-in.
GOOGLE_CLIENT_ID=<get-from-google-cloud-console>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<get-from-google-cloud-console>

# Sameday Courier (optional): waybills (AWBs) generated from the admin orders
# page, and easybox lockers in the cart. API credentials come from Sameday
# (demo first, then production). The locker client id identifies this site's
# domain to Sameday's easybox map; request it from app.support@sameday.ro.
# Without it easybox is not offered. Leave all empty for home delivery only,
# with waybills made by hand in eAWB.
#   Demo:       https://sameday-api.demo.zitec.com
#   Production: https://api.sameday.ro
SAMEDAY_API_URL=
SAMEDAY_USERNAME=
SAMEDAY_PASSWORD=
SAMEDAY_LOCKER_CLIENT_ID=

# Grafana (dashboards and alerts at https://<your-domain>/grafana/). Sign-up
# and anonymous access are disabled; this is the only account. MUST BE SET.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<change-me-strong-random>
# Where Grafana alerts are emailed (sent through the SMTP relay above).
GRAFANA_ALERT_EMAIL=miedaria.paunilor@gmail.com
