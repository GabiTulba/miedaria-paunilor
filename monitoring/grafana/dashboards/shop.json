{
  "uid": "shop",
  "title": "Shop",
  "tags": [
    "miedaria",
    "shop"
  ],
  "timezone": "Europe/Bucharest",
  "editable": false,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "5m",
  "schemaVersion": 39,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "bucket",
        "label": "Group by",
        "type": "custom",
        "query": "1d,1w,30d",
        "current": {
          "text": "1d",
          "value": "1d"
        },
        "options": [
          {
            "text": "Day",
            "value": "1d",
            "selected": true
          },
          {
            "text": "Week",
            "value": "1w",
            "selected": false
          },
          {
            "text": "Month",
            "value": "30d",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Sales",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Revenue",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (currency) (increase(shop_paid_revenue_total[$__range]))",
          "instant": true,
          "legendFormat": "{{currency}}"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "noValue": "–"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Paid orders",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (currency) (increase(shop_paid_orders_total[$__range]))",
          "instant": true,
          "legendFormat": "{{currency}}"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "–"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Average order",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (currency) (increase(shop_paid_revenue_total[$__range])) / ((((sum by (currency) (increase(shop_paid_orders_total[$__range])) > 0) > 0) > 0) > 0)",
          "instant": true,
          "legendFormat": "{{currency}}"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "noValue": "–"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Bottles per order",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (currency) (increase(shop_bottles_sold_total[$__range])) / ((((sum by (currency) (increase(shop_paid_orders_total[$__range])) > 0) > 0) > 0) > 0)",
          "instant": true,
          "legendFormat": "{{currency}}"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "noValue": "–"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Checkouts started",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (currency) (increase(shop_checkouts_total[$__range]))",
          "instant": true,
          "legendFormat": "{{currency}}"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "–"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Paid conversion",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(shop_paid_orders_total[$__range])) / (sum(increase(shop_checkouts_total[$__range])) > 0)",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "description": "Share of checkouts started in the range that ended up paid.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "–"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Revenue per period",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (currency) (increase(shop_paid_revenue_total[$__interval] offset -$__interval))",
          "legendFormat": "{{currency}}",
          "interval": "$bucket"
        }
      ],
      "description": "Each bar covers the period starting at its date. Days start at 00:00 UTC (02:00 or 03:00 Bucharest time), weeks on Thursday and months are 30-day blocks.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "none"
            }
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Checkouts per period",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(shop_checkouts_total[$__interval] offset -$__interval))",
          "legendFormat": "Started",
          "interval": "$bucket"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(shop_paid_orders_total[$__interval] offset -$__interval))",
          "legendFormat": "Paid",
          "interval": "$bucket"
        }
      ],
      "description": "Each bar covers the period starting at its date. Days start at 00:00 UTC (02:00 or 03:00 Bucharest time), weeks on Thursday and months are 30-day blocks.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "none"
            }
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Products sold",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (product_id, currency) (increase(shop_bottles_sold_total[$__range]))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (product_id, currency) (increase(shop_product_revenue_total[$__range]))",
          "instant": true,
          "format": "table"
        }
      ],
      "description": "",
      "transformations": [
        {
          "id": "merge"
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "product_id": "Product",
              "currency": "Currency",
              "Value #A": "Bottles",
              "Value #B": "Revenue"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Bottles"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Revenue"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Bottles",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Orders by status now",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
