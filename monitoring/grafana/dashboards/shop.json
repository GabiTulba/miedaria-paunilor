            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "shop_stale_processing_orders",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "description": "Orders in processing for more than 3 days. The backend asks Stripe daily; an alert fires while this is above 0.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
