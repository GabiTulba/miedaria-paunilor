      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (from) (increase(site_page_views_total{from=~\"direct|search|social|email|other\"}[$__range]))",
          "instant": true,
          "legendFormat": "{{from}}"
        }
      ],
      "description": "Direct: no referring site (typed, bookmarked, or the site withheld it). Other: any site that is not a search engine, social network or webmail.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
