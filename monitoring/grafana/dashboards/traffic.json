    {
      "id": 9,
      "type": "piechart",
      "title": "Where visits come from",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 8
